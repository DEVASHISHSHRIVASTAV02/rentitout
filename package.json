{
  "name": "RentItOut",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "perf:smoke": "autocannon -c 50 -d 20 -l --renderStatusCodes http://127.0.0.1:3000/",
    "perf:max-rps": "node scripts/autocannon-max-rps.mjs",
    "perf:max-rps:home": "node scripts/autocannon-max-rps.mjs --url http://127.0.0.1:3000/ --start 10 --max 80 --step 10 --duration 30 --lag-ms 500 --max-error-pct 1",
    "perf:max-rps:browse": "node scripts/autocannon-max-rps.mjs --url http://127.0.0.1:3000/browse --start 10 --max 80 --step 10 --duration 30 --lag-ms 500 --max-error-pct 1",
    "prod:preflight": "node scripts/preflight-prod.mjs",
    "prod:build": "npm run prod:preflight && npm run lint && npm run build",
    "deploy:prod": "bash scripts/deploy-prod.sh"
  },
  "dependencies": {
    "autocannon": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
